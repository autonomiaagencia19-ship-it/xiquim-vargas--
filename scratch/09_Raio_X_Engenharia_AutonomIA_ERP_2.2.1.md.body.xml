<w:p><w:pPr><w:shd w:val="clear" w:color="auto" w:fill="F1F5F9"/><w:spacing w:before="100" w:after="100"/></w:pPr>
<w:r><w:rPr><w:rFonts w:ascii="Consolas" w:hAnsi="Consolas"/><w:color w:val="0F172A"/><w:sz w:val="18"/></w:rPr><w:t xml:space="preserve">stateDiagram-v2
    [*] --&gt; PENDENTE: Criado (Web / Vendedor / PDV)
    PENDENTE --&gt; SEPARACAO: Separação Iniciada
    PENDENTE --&gt; CANCELADO: Cancelado (Estorno do Saldo)
    SEPARACAO --&gt; ROTA: Rota Despachada para Veículo
    SEPARACAO --&gt; CANCELADO: Cancelado pela Torre
    ROTA --&gt; CONCLUIDO: Entrega com Sucesso + Comprovante
    ROTA --&gt; SEPARACAO: Insucesso Registrado (/fail)
    CONCLUIDO --&gt; [*]
    CANCELADO --&gt; [*]</w:t></w:r></w:p>
<w:p><w:pPr><w:pStyle w:val="Heading3"/><w:spacing w:before="180" w:after="80"/></w:pPr>
<w:r><w:rPr><w:b/><w:color w:val="061A4F"/><w:sz w:val="22"/></w:rPr><w:t xml:space="preserve">3.2 Invariantes de Engenharia Atendidos</w:t></w:r></w:p>
<w:p><w:pPr><w:pStyle w:val="ListBullet"/><w:spacing w:after="60" w:line="240" w:lineRule="auto"/></w:pPr>
<w:r><w:rPr><w:b/><w:color w:val="061A4F"/><w:sz w:val="22"/></w:rPr><w:t xml:space="preserve">Zero Negative Stock:</w:t></w:r>
<w:r><w:rPr><w:color w:val="333333"/><w:sz w:val="22"/></w:rPr><w:t xml:space="preserve"> O update de reserva de estoque (</w:t></w:r>
<w:r><w:rPr><w:rFonts w:ascii="Consolas" w:hAnsi="Consolas"/><w:color w:val="C7254E"/><w:shd w:val="clear" w:color="auto" w:fill="F9F2F4"/><w:sz w:val="20"/></w:rPr><w:t xml:space="preserve">UPDATE estoque SET quantidade_disponivel = quantidade_disponivel - ? WHERE ... AND quantidade_disponivel &gt;= ?</w:t></w:r>
<w:r><w:rPr><w:color w:val="333333"/><w:sz w:val="22"/></w:rPr><w:t xml:space="preserve">) valida atomicamente o saldo no momento da inserção.</w:t></w:r>
</w:p>
<w:p><w:pPr><w:pStyle w:val="ListBullet"/><w:spacing w:after="60" w:line="240" w:lineRule="auto"/></w:pPr>
<w:r><w:rPr><w:b/><w:color w:val="061A4F"/><w:sz w:val="22"/></w:rPr><w:t xml:space="preserve">Cálculo Monetário Inteiro:</w:t></w:r>
<w:r><w:rPr><w:color w:val="333333"/><w:sz w:val="22"/></w:rPr><w:t xml:space="preserve"> Totais e subtotais são convertidos para centavos (</w:t></w:r>
<w:r><w:rPr><w:rFonts w:ascii="Consolas" w:hAnsi="Consolas"/><w:color w:val="C7254E"/><w:shd w:val="clear" w:color="auto" w:fill="F9F2F4"/><w:sz w:val="20"/></w:rPr><w:t xml:space="preserve">Math.round(preco * 100) * quantidade</w:t></w:r>
<w:r><w:rPr><w:color w:val="333333"/><w:sz w:val="22"/></w:rPr><w:t xml:space="preserve">) antes de operações aritméticas e divisões finais.</w:t></w:r>
</w:p>
<w:p><w:pPr><w:pStyle w:val="ListBullet"/><w:spacing w:after="60" w:line="240" w:lineRule="auto"/></w:pPr>
<w:r><w:rPr><w:b/><w:color w:val="061A4F"/><w:sz w:val="22"/></w:rPr><w:t xml:space="preserve">Fallback Instantâneo dos APKs:</w:t></w:r>
<w:r><w:rPr><w:color w:val="333333"/><w:sz w:val="22"/></w:rPr><w:t xml:space="preserve"> Interceptação nativa de requisições web locais (</w:t></w:r>
<w:r><w:rPr><w:rFonts w:ascii="Consolas" w:hAnsi="Consolas"/><w:color w:val="C7254E"/><w:shd w:val="clear" w:color="auto" w:fill="F9F2F4"/><w:sz w:val="20"/></w:rPr><w:t xml:space="preserve">shouldInterceptRequest</w:t></w:r>
<w:r><w:rPr><w:color w:val="333333"/><w:sz w:val="22"/></w:rPr><w:t xml:space="preserve">) garantindo abertura em ~0.05s em modo avião.</w:t></w:r>
</w:p>