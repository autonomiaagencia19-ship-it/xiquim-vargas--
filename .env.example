NODE_ENV=production
PORT=3000
JWT_SECRET=gere-um-segredo-forte-e-unico
# Em Render, o render.yaml já aponta para o disco persistente.
STORAGE_DIR=/var/data
# Opcional: endereço público fixo para os links de acesso exibidos na Torre.
PUBLIC_BASE_URL=https://seu-erp.onrender.com

# IA Administrativa (Groq - openai/gpt-oss-120b)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Google Maps API (Roteirização por rota mais curta na malha viária, sem trânsito ao vivo)
GOOGLE_MAPS_API_KEY=
